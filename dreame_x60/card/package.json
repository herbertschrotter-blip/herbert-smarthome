{
  "name": "dreame-x60-panel",
  "version": "2.0.0-alpha.1",
  "private": true,
  "description": "dreame_x60 – Neubau der Heidi-Karte (Custom Lovelace Card, Lit 3, TypeScript). Bundle: ha/www/dreame_x60.js",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "node --import tsx --test tests/unit/*.test.ts",
